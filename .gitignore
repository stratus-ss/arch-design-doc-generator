# ── Client config (any directory; never commit) ─────────────────────
**/project.yaml
**/project.yaml.bak.*
.env
.env.*
!.env.example

# ── Filled slot maps (any directory, including repo root) ───────────
**/slot_map.json
**/slot_map.fingerprint.json

# ── Engagement ADR working copies (repo-root only) ───────────────────
# Templates are git-tracked under templates/ADR/. Do not use unanchored
# ADR/ — that would also ignore templates/ADR/.
/ADR/

# ── Build output (default and alternate roots, e.g. output-claude/) ─
output/
output-*/
HLD/PDFs/
LLD/PDFs/
LLD/diagrams/
HLD/diagrams/
HLD/READOUT/
Work_Items/
Drawio_*.md
*_combined_deterministic.md
*.pdf

# ── Exported PNGs (generated, not source) ────────────────────────────
*.png

# ── Client RVTools dumps (never source) ──────────────────────────────
RVTools/
*.xlsx

# ── AI pipeline runtime state ────────────────────────────────────────
drafts/
drafts_deterministic/
.deterministic/
.cursor-sdk-venv/

# ── Python ───────────────────────────────────────────────────────────
venv/
__pycache__/
*.pyc
*.pyo
*.egg-info/
.eggs/
.pytest_cache/
.ruff_cache/

# ── Node ─────────────────────────────────────────────────────────────
node_modules/
dist/

# ── OS ───────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Editor ───────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
.cursor/

# ── Generated local-only Health Check artifacts ─────────────────────
docs/HC_RECOMMENDATION_AUDIT_LOG.md

# ── Local planning / scratch (do not commit) ────────────────────────
# Session execution state never ships — keep this rule even if agent_planning/
# is later tracked. Listed after agent_planning/ so it remains last-match.
agent_planning/
**/agent_planning/execution/
cursor_plans/
.buddy/
google-cloud-sdk/
tmp/

# ── Kubeconfigs (never commit) ──────────────────────────────────────
**/kubeconfig
**/kubeconfig.*
**/.kube/
